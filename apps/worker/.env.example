# Background worker — conversation, payment and notification queues.
# Copy to .env (development) or inject through the host (production).

NODE_ENV=development
APP_NAME=Nailbook
LOG_LEVEL=info
LOGTAIL_INGESTION_HOST=
LOGTAIL_SOURCE_TOKEN=

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wannys_nails?schema=public"

# WhatsApp Cloud API (conversation + notification)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0
# Owner's personal number (E.164) — fallback for human-escalation alerts
OWNER_WHATSAPP_PHONE=

# Daraja / M-Pesa (payment)
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_STK_PUSH_URL=
DARAJA_STK_QUERY_URL=
DARAJA_CALLBACK_URL=

# Email (Resend) — optional
RESEND_API_KEY=

# Web Push (admin notifications) — optional
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
