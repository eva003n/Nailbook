{
  "name": "@nailbook/worker",
  "version": "1.0.0",
  "description": "Background worker — conversation FSM, payments and notifications",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:dev": "tsc -p tsconfig.build.json --watch",
