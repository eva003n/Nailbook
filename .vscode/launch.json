  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Server",
      "cwd": "${workspaceFolder}/apps/api",
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Worker",
      "cwd": "${workspaceFolder}/apps/worker",
    },
    {
      "type": "firefox",
      "request": "launch",
      "name": "Client",
      "skipFiles": ["node_modules/**", "coverage/**", "dist/**", "playwright-report/**", "test-results/**"],
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/apps/web"
    },
    
  ],
  "compounds": [
    {
        "name": "Server, Worker and client",
        "configurations": []
    }
  ]
}
